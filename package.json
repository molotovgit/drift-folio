{
  "name": "drift-folio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run build && npm test && npm run e2e",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages --nojekyll -m deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/three": "0.186.0",
    "gh-pages": "6.3.0",
    "happy-dom": "20.14.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
